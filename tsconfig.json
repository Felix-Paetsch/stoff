{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020"],
        "module": "ESNext",
        "moduleResolution": "node",
        "noUncheckedIndexedAccess": true,
        "strictNullChecks": true,
        "noImplicitAny": true,
        "noImplicitOverride": true,
        "noUnusedParameters": true,
        "noUnusedLocals": true,
        "strictFunctionTypes": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "allowJs": false,
        "checkJs": false,
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "isolatedModules": false,
        "declaration": false,
        "allowImportingTsExtensions": false,
        "outDir": "./out/build",
        "rootDir": "./",
        "baseUrl": "./",
        "paths": {
            "@/Core/config": ["Core/config"],

            "@/Core/geometry": ["Core/geometry"],
            "@/Core/numerics": ["Core/numerics"],
            "@/Core/colors": ["Core/colors"],
            "@/Core/expect": ["Core/expect"],
            "@/Core/utils": ["Core/utils"],
            "@/Core/random": ["Core/random"],
            "@/Core/sketch": ["Core/sketch"],
            "@/Core/svg": ["Core/svg"],

            "@/ProcArt/graph": ["ProcedualArt/primitives/graph"],
            "@/ProcArt/grid": ["ProcedualArt/primitives/grid"],
            "@/ProcArt/embroidery": ["ProcedualArt/primitives/embroidery"],
            "@/ProcArt/image": ["ProcedualArt/primitives/image"],
            "@/ProcArt/pathing": ["ProcedualArt/primitives/pathing"],

            "@/ProcArt/rendering": ["ProcedualArt/primitives/rendering"],
            "@/ProcArt/adapters": ["ProcedualArt/primitives/adapters"],

            "@/ProcArt/design_approaches": ["ProcedualArt/design_approaches"],

            "@/Dev": ["Dev/Lib"]
        }
    },
    "include": ["**/*.ts", "**/*.js", "**/*.d.ts", "Algorithms/dubplicate_edges.ts.broken", "Core/geometry/algorithms/self_intersection_free.ts.broken", "ProcedualArt/core/pathing/modify_self_intersections.tsns.ts", "Core/geometry/algorithms/merge_shapes.ts", "Rust/src/procedual_art/grid/algorithms/eikonal/index.rskonal/index.rs"],
    "exclude": [
        "node_modules",
        "dist",
        "Dev/Server"
    ],
    "ts-node": {
        "esm": true,
        "experimentalSpecifierResolution": "node"
    }
}
