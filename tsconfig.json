{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020"],
        "module": "ESNext",
        "moduleResolution": "node",
        "noUncheckedIndexedAccess": true,
        "strictNullChecks": true,
        "noImplicitAny": true,
        "noImplicitOverride": true,
        "noUnusedParameters": true,
        "noUnusedLocals": true,
        "strictFunctionTypes": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "allowJs": false,
        "checkJs": false,
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "isolatedModules": false,
        "declaration": false,
        "allowImportingTsExtensions": false,
        "outDir": "./out/build",
        "rootDir": "./",
        "baseUrl": "./",
        "paths": {
            "@/Core": ["Core/index"],
            "@/Core/files": ["Core/files"],
            "@/Core/geometry": ["Core/geometry/index"],
            "@/Core/sketch": ["Core/sketch/index"],
            "@/Core/grid": ["Core/grid/index"],
            "@/Core/graph": ["Core/graph/index"],
            "@/Core/colors": ["Core/colors"],

            "@/Dev": ["Dev/Lib"]
        }
    },
    "include": ["**/*.ts", "**/*.js", "**/*.d.ts", "Algorithms/dubplicate_edges.ts.broken", "Core/geometry/algorithms/self_intersection_free.ts.broken", "Core/geometry/algorithms/modify_self_intersections.ts", "Core/geometry/algorithms/merge_shapes.ts"],
    "exclude": [
        "node_modules",
        "dist",
        "Dev/Server"
    ],
    "ts-node": {
        "esm": true,
        "experimentalSpecifierResolution": "node"
    }
}
